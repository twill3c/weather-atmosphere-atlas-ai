# 外部データの生ファイルはリポジトリに入れない(SPEC N-04)
data/raw/
data/staging/
data/cache/
data/processed/*.parquet
data/models/*.pt
data/models/*.joblib

# NIES の生ファイルは再配布しない(SPEC §2.5)
*.zip
!tests/fixtures/**/*.zip

# 大きな外部形式
*.grib
*.grb
*.h5
*.hdf5

# Node / Next
node_modules/
.next/
out/
*.tsbuildinfo

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# 環境
.env
.env.local
.vercel
